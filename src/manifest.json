{
  "name": "Tabs Combiner",
  "description": "Organize and manage browser tabs by domain groups. Close, organize, and control tabs efficiently with customizable domain-based grouping.",
  "version": "0.0.3",
  "manifest_version": 3,
  "icons": {
    "16": "images/dark/dark-extension-icon16.png",
    "48": "images/dark/dark-extension-icon48.png",
    "128": "images/dark/dark-extension-icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/dark/dark-extension-icon16.png",
      "48": "images/dark/dark-extension-icon48.png",
      "64": "images/dark/dark-extension-icon64.png",
      "128": "images/dark/dark-extension-icon128.png"
    }
  }
}
